# Postgres (Supabase: Project Settings → Database → Connection string, режим "Session pooler")
DATABASE_URL=postgresql+psycopg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Логин/пароль для входа в /admin (обязательно смени перед продом)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Supabase Storage (Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-from-supabase
SUPABASE_BUCKET=uploads

# Канонический адрес сайта — идёт в canonical, og:url и sitemap.xml.
# Без него поисковик может проиндексировать дубли по разным хостам.
SITE_URL=https://adygid.ru

# Номер счётчика Яндекс.Метрики (только цифры). Пусто — счётчик не грузится,
# чтобы локальная разработка не пачкала статистику.
YANDEX_METRIKA_ID=

# Админка бота MAX: страницы «Входящие» и «Шаблоны бота».
# Токен только на сервере (Railway). В репозиторий и в браузер он не попадает.
# Без BOT_API_TOKEN эти страницы показывают, что бот не подключён, и не падают.
BOT_API_URL=https://d5dcnh3b6fsskkqbhnvq.emzafcgx.apigw.yandexcloud.net
BOT_API_TOKEN=
