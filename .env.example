# Postgres (Supabase: Project Settings → Database → Connection string, режим "Session pooler")
DATABASE_URL=postgresql+psycopg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Логин/пароль для входа в /admin (обязательно смени перед продом)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Supabase Storage (Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-from-supabase
SUPABASE_BUCKET=uploads
